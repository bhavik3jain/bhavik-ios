<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.bhavikjain.trackers</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- Trips and Explore forecasts. Only valid because WeatherKit is enabled
	     for com.bhavikjain.trackers in the developer portal (both the
	     Capabilities and App Services tabs): an entitlement the provisioning
	     profile doesn't grant fails signing. Without it every WeatherKit call
	     throws and both modules quietly show no weather at all. -->
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<!-- CloudKit's silent pushes, the Mac spelling of iOS's aps-environment.
	     Without it a partner's change only appeared when the app was next
	     activated or relaunched, minutes later. "development" is right for a
	     local build; TestFlight's App Store export takes "production" from the
	     App Store profile it fetches. (The retired Developer ID route once
	     failed here: a hand-downloaded profile predated push.) -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<!-- CloudKit refuses to hand a Mac app its private database unless the app
	     is sandboxed, so the sandbox is a requirement here, not a hardening
	     choice. The keys below are what it then has to give back. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Without this the sandbox denies every outbound connection and the TMDB
	     and FedEx clients fail silently: URLSession just returns an error the
	     UI shows as "no results", with nothing in the log pointing at signing. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Lets the Fuelly CSV importer read the file the user picks in the open
	     panel, and Finance's Export to Numbers save the filled sheet where the
	     user picks in the save panel. Read-only was enough until that export. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Finance's Export to Numbers drives Numbers through Apple events
	     (App/Sources/MacFinanceNumbers.swift). The sandbox blocks every Apple
	     event unless the target is listed here, and the hardened runtime
	     blocks them unless the second key is set; missing either, the export
	     fails with -1743 and macOS never asks for Automation permission. The
	     temporary exception passes upload and internal TestFlight, which has
	     no review; App Review may question it on submission, since Numbers
	     offers no scripting-targets entitlement to use instead. -->
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array>
		<string>com.apple.Numbers</string>
	</array>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Lets Explore's guide map show where you are. Without it the sandbox
	     refuses Core Location outright: no permission prompt ever appears,
	     the map never shows the blue dot, and the distance on a place's card
	     simply never shows up, with nothing in the log to say why. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Finance's report window prints (Print, ⌘P) and saves as PDF, both
	     through NSPrintOperation (Core's HTMLDocumentExport). The sandbox
	     refuses printing without this key; nothing in the app printed before
	     the report, and the export's one test runs in the unsandboxed test
	     host, so nothing would have caught it. -->
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
