<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.bhavikjain.trackers</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- Trips and Explore forecasts. Only valid because WeatherKit is enabled
	     for com.bhavikjain.trackers in the developer portal (both the
	     Capabilities and App Services tabs): an entitlement the provisioning
	     profile doesn't grant fails signing. Without it every WeatherKit call
	     throws and both modules quietly show no weather at all. -->
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<!-- CloudKit's silent pushes, which are how NSPersistentCloudKitContainer
	     learns another device changed the database. Without it the pushes never
	     arrive (UIBackgroundModes remote-notification alone isn't enough), so a
	     partner's new itinerary item or fuel-up only appeared at the next launch
	     or return to the foreground, minutes later. "development" is right for
	     every local build: Xcode rewrites it to "production" from the
	     provisioning profile when exporting for TestFlight or the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
