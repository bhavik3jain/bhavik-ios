<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.bhavikjain.trackers</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- Trips and Explore forecasts. Only valid because WeatherKit is enabled
	     for com.bhavikjain.trackers in the developer portal (both the
	     Capabilities and App Services tabs): an entitlement the provisioning
	     profile doesn't grant fails signing. Without it every WeatherKit call
	     throws and both modules quietly show no weather at all. -->
	<key>com.apple.developer.weatherkit</key>
	<true/>
</dict>
</plist>
